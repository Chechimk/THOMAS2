uninstall_panel() {
    header "[!] UNINSTALL PANEL"
    warn "This will permanently remove the panel and all configurations."
    if confirm "Are you sure you want to uninstall?"; then
        bash /etc/panel/install.sh --uninstall
    fi
}

while true; do
    show_menu
    read -rp "  Enter an option: " opt
    case "$opt" in
        1) accounts_menu ;;
        2) bash "$SBIN_DIR/protocolos" ;;
        3) extra_tools_menu ;;
        4) script_config_menu ;;
        5) uninstall_panel ;;
        r|R) confirm "Restart VPS now?" && reboot ;;
        e|E) clear; exit 0 ;;
        q|Q) confirm "Logout?" && logout || true ;;
    esac
done
