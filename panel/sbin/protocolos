#!/bin/bash
source /etc/panel/lib/common.sh
require_root

while true; do
    # Live ON/OFF status for each protocol
    ssh_port=$(grep -E "^Port " /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}' | head -1)
    xray_port=$(ls /usr/local/etc/xray/conf/*.json 2>/dev/null | head -1 | \
        xargs -I{} python3 -c "import json,sys; c=json.load(open('{}'));print(c['inbounds'][0]['port'])" 2>/dev/null)

    clear
    line_top
    _center "PROTOCOL MANAGER"
    line_mid
    printf "${RED}║${RESET}  ${CYAN}SSH: %-8s${RESET}                  ${CYAN}XRAY: %-20s${RESET}${RED}║${RESET}\n" \
        "${ssh_port:-22}" "${xray_port:-OFF}"
    line_mid
    printf "${RED}║${RESET}  ${CYAN}[1]>${RESET}  ${WHITE}%-18s${RESET}  %s  ${CYAN}[10]>${RESET}  ${WHITE}%-14s${RESET}  %s  ${RED}║${RESET}\n" \
        "SSH SETTINGS"    "$(service_status ssh)"    "SQUID"        "$(service_status squid)"
    printf "${RED}║${RESET}  ${CYAN}[2]>${RESET}  ${WHITE}%-18s${RESET}  %s  ${CYAN}[11]>${RESET}  ${WHITE}%-14s${RESET}  %s  ${RED}║${RESET}\n" \
        "DROPBEAR"        "$(service_status dropbear)" "OPENVPN"    "$(service_status openvpn@server)"
    printf "${RED}║${RESET}  ${CYAN}[3]>${RESET}  ${WHITE}%-18s${RESET}  %s  ${CYAN}[12]>${RESET}  ${WHITE}%-14s${RESET}  %s  ${RED}║${RESET}\n" \
        "SOCKS PYTHON"    "$(service_status sockspy)"  "CHECKUSER"  "$(service_status checkuser)"
    printf "${RED}║${RESET}  ${CYAN}[4]>${RESET}  ${WHITE}%-18s${RESET}  %s  ${CYAN}[13]>${RESET}  ${WHITE}%-14s${RESET}  %s  ${RED}║${RESET}\n" \
        "STUNNEL (SSL)"   "$(service_status stunnel4)" "ATOKEN"     "$(service_status atoken)"
    printf "${RED}║${RESET}  ${CYAN}[5]>${RESET}  ${WHITE}%-18s${RESET}  %s  ${CYAN}[14]>${RESET}  ${WHITE}%-14s${RESET}  %s  ${RED}║${RESET}\n" \
        "SLOWDNS"         "$(service_status slowdns)"  "FILEBROWSER" "$(service_status filebrowser)"
    printf "${RED}║${RESET}  ${CYAN}[6]>${RESET}  ${WHITE}%-18s${RESET}  %s  ${CYAN}[15]>${RESET}  ${WHITE}%-14s${RESET}  %s  ${RED}║${RESET}\n" \
        "WS-EPRO"         "$(service_status ws-epro)"  "V2RAY/XRAY" "$(service_status xray)"
    printf "${RED}║${RESET}  ${CYAN}[7]>${RESET}  ${WHITE}%-18s${RESET}  %s  ${CYAN}[16]>${RESET}  ${WHITE}%-14s${RESET}  %s  ${RED}║${RESET}\n" \
        "UDP-CUSTOM"      "$(service_status udp-custom)" "SSHGO"    "$(service_status sshgo)"
    printf "${RED}║${RESET}  ${CYAN}[8]>${RESET}  ${WHITE}%-18s${RESET}  %s  ${CYAN}[17]>${RESET}  ${WHITE}%-14s${RESET}  %s  ${RED}║${RESET}\n" \
        "UDP-HYSTERIA"    "$(service_status hysteria)"  "WIREGUARD" "$(service_status wg-quick@wg0)"
    printf "${RED}║${RESET}  ${CYAN}[9]>${RESET}  ${WHITE}%-18s${RESET}  %s  ${RESET}%30s${RED}║${RESET}\n" \
        "BADVPN-UDPGW"   "$(service_status badvpn)"    ""
    line_mid
    printf "${RED}║${RESET}  ${BRED}[0]${RESET}  ${BOLD}${WHITE}Back${RESET}%55s${RED}║${RESET}\n" ""
    line_bot
    echo ""
    read -rp "  Enter an Option: " opt
    case "$opt" in
        1)  bash "$SBIN_DIR/sshManager" ;;
        2)  bash "$SBIN_DIR/dropBear" ;;
        3)  bash "$SBIN_DIR/socksPY" ;;
        4)  bash "$SBIN_DIR/Stunnel" ;;
        5)  bash "$SBIN_DIR/Slowdns" ;;
        6)  bash "$SBIN_DIR/wsEpro" ;;
        7)  bash "$SBIN_DIR/udp-custom" ;;
        8)  bash "$SBIN_DIR/udp-hysteria" ;;
        9)  bash "$SBIN_DIR/badvpn" ;;
        10) bash "$SBIN_DIR/Squid" ;;
        11) bash "$SBIN_DIR/openVPN" ;;
        12) bash "$SBIN_DIR/checkuser" ;;
        13) bash "$SBIN_DIR/aToken" ;;
        14) bash "$SBIN_DIR/fileBrowser" ;;
        15) bash "$SBIN_DIR/v2rayManager" ;;
        16) bash "$SBIN_DIR/sshGo" ;;
        17) bash "$SBIN_DIR/WgAdmin" ;;
        0)  break ;;
    esac
done
