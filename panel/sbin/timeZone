#!/bin/bash
source /etc/panel/lib/common.sh
require_root

while true; do
    header "MODIFY TIME ZONE"
    printf "  ${DIM}Current: ${RESET}${WHITE}%s${RESET}\n" "$(timedatectl | grep 'Time zone' | awk '{print $3}')"
    line
    echo -e "  ${CYAN}[1]${RESET}  Set Time Zone"
    echo -e "  ${CYAN}[2]${RESET}  List Available Zones"
    echo -e "  ${CYAN}[3]${RESET}  Sync Time (NTP)"
    echo -e "  ${YELLOW}[0]${RESET}  Back"
    line
    read -rp "  Enter an option: " opt
    case "$opt" in
        1) get_input "Time zone (e.g. America/New_York)" tz
           timedatectl set-timezone "$tz" && ok "Time zone set to $tz." || err "Invalid time zone." ; press_enter ;;
        2) timedatectl list-timezones | less ;;
        3) timedatectl set-ntp true && ok "NTP sync enabled." ; press_enter ;;
        0) break ;;
    esac
done
